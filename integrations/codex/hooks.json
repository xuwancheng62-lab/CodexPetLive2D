{
  "description": "Send Codex lifecycle state to Codex Live2D Pet.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "__PET_HOOK_COMMAND__", "timeout": 3 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PET_HOOK_COMMAND__",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PET_HOOK_COMMAND__",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PET_HOOK_COMMAND__",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PET_HOOK_COMMAND__",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PET_HOOK_COMMAND__",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PET_HOOK_COMMAND__",
            "async": true,
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "__PET_HOOK_COMMAND__", "timeout": 3 }
        ]
      }
    ]
  }
}
